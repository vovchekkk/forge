# Forge runner on your PC. Copy to .env.runner on the machine that runs jobs.
# The runner connects OUT to the server over HTTPS; only the server needs a public IP.

# Server URL (HTTPS via Caddy). Must be reachable from the PC running the runner.
FORGE_SERVER_URL=https://forge-ci.ru

# Runner registration credential: obtain it from `POST /api/runners` (shown only once).
FORGE_SERVER_TOKEN=change-me-to-a-long-random-string

# Optional: credentials for cloning private repositories
FORGE_GIT_USERNAME=
FORGE_GIT_PASSWORD=
