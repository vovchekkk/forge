# syntax=docker/dockerfile:1

# Build stage: compile the whole reactor with Maven
FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /build
COPY pom.xml .
COPY shared shared
COPY forge-server forge-server
COPY forge-runner forge-runner
COPY forge-e2e forge-e2e
RUN mvn -q -DskipTests -pl forge-server -am package

# Runtime stage
FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /build/forge-server/target/forge-server-*-exec.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]