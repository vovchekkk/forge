POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me
# Access-token signing secret for the server (min 32 chars). MUST be a strong random value in production.
FORGE_JWT_SECRET=change-me-to-a-long-random-secret
# Runner registration credential: obtain it from `POST /api/runners` (shown only once).
FORGE_SERVER_TOKEN=change-me-to-a-long-random-string
FORGE_WORKSPACE_DIR=/srv/forge/workspaces

# Optional: credentials for cloning private repositories
FORGE_GIT_USERNAME=
FORGE_GIT_PASSWORD=

# Optional: comma-separated list of allowed browser origins (empty = same-origin only)
# FORGE_CORS_ORIGINS=https://ci.example.com